# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
# This key is used by LangChain to call Gemini for interview evaluation and job analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RETRY_ATTEMPTS=1
GEMINI_RETRY_BACKOFF_SECONDS=0.5
GEMINI_MODEL_DISCOVERY_TIMEOUT_SECONDS=5

# n8n Webhook for Automation (Phase 5)
N8N_WEBHOOK_URL=

# Database Configuration
# Local development defaults to SQLite when DATABASE_URL is omitted.
# Render PostgreSQL: DATABASE_URL=postgresql://<user>:<password>@<host>/<database>
DATABASE_URL=sqlite:///./interviewiq.db

# Application Mode
# Set to 'development' or 'production'
APP_ENV=development
# Set APP_ENV=production on Render. The app then fails startup if PostgreSQL is unavailable.
PUBLIC_API_BASE_URL=https://your-public-ngrok-url.ngrok-free.dev
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
